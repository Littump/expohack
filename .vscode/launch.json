{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/backend/.env",
            "args": [
                "runserver"
            ],
            "justMyCode": false,
            "python": "${workspaceFolder}/backend/venv/bin/python",
            "program": "${workspaceFolder}/backend/manage.py",
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Start Worker",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/model/.env",
            "justMyCode": false,
            "python": "${workspaceFolder}/model/venv/bin/python",
            "program": "${workspaceFolder}/model/main.py",
            "cwd": "${workspaceFolder}/model"
        }
    ]
}